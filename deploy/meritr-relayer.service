[Unit]
Description=Meritr Attestcoin relayer - continuously ingests real Ethereum Aave activity
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meritr
WorkingDirectory=/opt/meritr
EnvironmentFile=/etc/meritr/relayer.env
ExecStart=/usr/bin/node /opt/meritr/scripts/attestcoin/relay.js --interval 240 --max-per-cycle 2
Restart=always
RestartSec=15
StartLimitIntervalSec=300
StartLimitBurst=5
KillSignal=SIGTERM
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal
# The relayer key holds no roles, but hardening costs nothing.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/meritr/var

[Install]
WantedBy=multi-user.target
