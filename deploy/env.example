# ── /etc/meritr/relayer.env ──────────────────────────────────────────────────
# Zero roles. MeritrAttestor.ingest has no onlyRole, so this key can do nothing
# except pay gas to submit proofs that are self-validating.
MERITR_NETWORK=creditcoinTestnet
MERITR_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
RELAYER_PRIVATE_KEY=
# Optional comma-separated Ethereum RPCs tried before the public fallbacks. A paid endpoint
# here removes the getLogs limits that force 50-block scan windows.
ETHEREUM_RPC_URL=

# ── /etc/meritr/agent.env ────────────────────────────────────────────────────
# RISK_AGENT_ROLE only. Cannot pause, cannot set prices, cannot register schemas.
# Note there is deliberately NO PRIVATE_KEY fallback — see agents/config.py.
MERITR_NETWORK=creditcoinTestnet
MERITR_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
RISK_AGENT_PRIVATE_KEY=
MERITR_POLL_INTERVAL=300

# ── /etc/meritr/api.env ──────────────────────────────────────────────────────
# NO KEY AT ALL. Restructuring simulation is a read-only call made *as* the risk
# agent address, which the API reads from the address book.
MERITR_NETWORK=creditcoinTestnet
MERITR_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
MERITR_CORS_ORIGINS=https://meritr.example.com
