[Unit]
Description=Meritr web console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meritr
WorkingDirectory=/opt/meritr
Environment=NODE_ENV=production
# Serves the .next build produced on the laptop and rsynced across — the box needs no
# build toolchain, and a small VPS will OOM on `next build` anyway.
ExecStart=/usr/bin/npx next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
