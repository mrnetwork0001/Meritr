# ── Meritr environment ────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Creditcoin EVM Testnet (Chain ID 102031)
CREDITCOIN_TESTNET_RPC=https://rpc.cc3-testnet.creditcoin.network

# Deployer key. Fund it from the Creditcoin testnet faucet before deploying.
PRIVATE_KEY=

# The autonomous risk agent's key. Grant it RISK_AGENT_ROLE at deploy time via
# RISK_AGENT_ADDRESS. It can only *trigger* restructurings — every rate, term and relief
# amount is recomputed on-chain — so it needs no privileged custody of funds.
RISK_AGENT_PRIVATE_KEY=
RISK_AGENT_ADDRESS=

# Which deployment the agent, API and doctor target (matches deployments/<name>.json).
MERITR_NETWORK=creditcoinTestnet
# MERITR_RPC_URL=            # overrides the network default
# MERITR_POLL_INTERVAL=60    # seconds between agent cycles

# Point the vault at existing tokens instead of deploying demo ERC-20s.
# MERITR_ASSET=
# MERITR_ASSET_DECIMALS=6
# MERITR_COLLATERAL=
# MERITR_COLLATERAL_DECIMALS=18

# Frontend -> backend
NEXT_PUBLIC_MERITR_API=http://localhost:8000
# MERITR_CORS_ORIGINS=https://meritr.example   # pin exact origins in production
