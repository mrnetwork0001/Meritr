# ── Meritr environment ────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Creditcoin EVM. Chain ids verified live against these endpoints:
#   102030 mainnet · 102031 testnet · 102032 devnet
CREDITCOIN_MAINNET_RPC=https://mainnet3.creditcoin.network
CREDITCOIN_TESTNET_RPC=https://rpc.cc3-testnet.creditcoin.network

# Deployer key. Fund it with CTC before deploying.
PRIVATE_KEY=

# The autonomous risk agent's key. Grant it RISK_AGENT_ROLE at deploy time via
# RISK_AGENT_ADDRESS. It can only *trigger* restructurings — every rate, term and relief
# amount is recomputed on-chain — so it needs no privileged custody of funds.
RISK_AGENT_PRIVATE_KEY=
RISK_AGENT_ADDRESS=

# Which deployment the agent, API and doctor target (matches deployments/<name>.json).
MERITR_NETWORK=creditcoinTestnet
# MERITR_RPC_URL=            # overrides the network default
# MERITR_POLL_INTERVAL=60    # seconds between agent cycles

# Point the vault at existing tokens instead of deploying demo ERC-20s.
# REQUIRED on mainnet: MockERC20 has an open mint, so the deploy script refuses to ship it
# to chain 102030 unless MERITR_ALLOW_MOCK_TOKENS=yes is set deliberately.
# MERITR_ASSET=
# MERITR_ASSET_DECIMALS=6
# MERITR_COLLATERAL=
# MERITR_COLLATERAL_DECIMALS=18

# Attestcoin proof-builder. Defaults are resolved per network in scripts/attestcoin/prover.js;
# set this only to override.
#   testnet  https://proof-gen-api.cc3-testnet.creditcoin.network
#   mainnet  https://proofbuilder.cc3-mainnet-usc.creditcoin.network
# CREDITCOIN_PROOF_BUILDER_URL=

# ── Mainnet safety gates ──────────────────────────────────────────────────────
# Deploying a lending protocol that custodies real deposits should be deliberate, so the
# deploy script refuses chain 102030 until this is set. The contracts are not audited.
# MERITR_CONFIRM_MAINNET=yes
# MERITR_ALLOW_MOCK_TOKENS=yes

# Frontend -> backend
NEXT_PUBLIC_MERITR_API=http://localhost:8000
# MERITR_CORS_ORIGINS=https://meritr.example   # pin exact origins in production
